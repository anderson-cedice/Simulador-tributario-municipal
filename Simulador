  // Format integer part with dots
  const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const decPart = parts.length > 1 ? ',' + parts[1] : '';
  el.value = intPart + decPart;
  updateResults();
}

function handleIncomeKeydown(e) {
  // Permitir atajos (pegar, copiar, cortar, seleccionar todo, deshacer)
  if (e.ctrlKey || e.metaKey) return;
  // Allow: backspace, delete, tab, escape, arrows, home, end
  if ([8,9,27,46,37,38,39,40,35,36].includes(e.keyCode)) return;
  // Allow digits and comma
  if ((e.key >= '0' && e.key <= '9') || e.key === ',') return;
  e.preventDefault();
}

function getIncomeRaw() {
  const val = document.getElementById('incomeInput').value;
  // Remove dots (thousand separators), replace comma with dot for parseFloat
  return parseFloat(val.replace(/\./g, '').replace(',', '.')) || 0;
}


