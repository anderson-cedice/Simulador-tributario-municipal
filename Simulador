function updatePaso4() {
  const noAct = document.getElementById('paso4NoActivity');
  const content = document.getElementById('paso4Content');
  const results = document.getElementById('paso4Results');
  const noMuni = document.getElementById('paso4NoMuni');

  if (!selectedActivity) {
    noAct.style.display = '';
    content.style.display = 'none';
    return;
  }
  noAct.style.display = 'none';
  content.style.display = '';

  // Update income2 label to match currency
  document.getElementById('income2Label').textContent =
    PROFILE_CONFIG[document.getElementById('userProfile').value].inputLabel(currency)
      .replace('(', '— segunda actividad (');

  const muniP = document.getElementById('muniPrimary').value;

  if (!selectedActivity2 || !muniP) {
    results.style.display = 'none';
    noMuni.style.display = (!selectedActivity2) ? 'none' : '';
    if (!muniP && selectedActivity2) noMuni.style.display = '';
    return;
  }

  results.style.display = '';
  noMuni.style.display = 'none';

  const inc1Bs = toBs(getIncomeRaw(), currency);
  const inc2Bs = toBs(getIncome2Raw(), currency);

  // IVA adjustments for both activities
  const ivaInfo1 = selectedActivity ? getIVAInfo(selectedActivity.codigo) : {tasa:16, nota:'', excepciones:[]};
  const ivaInfo2 = selectedActivity2 ? getIVAInfo(selectedActivity2.codigo) : {tasa:16, nota:'', excepciones:[]};
  const base1AfterIVABs = calcBaseAfterIVA(inc1Bs, ivaInfo1.tasa);
  const base2AfterIVABs = calcBaseAfterIVA(inc2Bs, ivaInfo2.tasa);
  const iva1Bs = inc1Bs - base1AfterIVABs;
  const iva2Bs = inc2Bs - base2AfterIVABs;

  const totalIncBs = base1AfterIVABs + base2AfterIVABs;

  const d1 = selectedActivity.municipios[muniP];
  const d2 = selectedActivity2.municipios[muniP];
