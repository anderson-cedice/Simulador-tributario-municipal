function toBs(amount, cur) {
  if (cur === 'EUR') return amount * TEUR;
  if (cur === 'USD') return amount * TUSD;
  return amount;
}
function fmtCur(amountBs, cur) {
  if (cur === 'EUR') return fmtEur(amountBs / TEUR);
  if (cur === 'USD') return fmtUsd(amountBs / TUSD);
  return fmtBs(amountBs);
}
function curSymbol(cur) {
  return cur === 'EUR' ? '€' : cur === 'USD' ? 'USD' : 'Bs.';
}

