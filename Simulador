function populateActivity2(activity1) {
  const listEl = document.getElementById('activity2List');
  document.getElementById('activity2Search').value = '';
  if (!activity1) {
    activity2Peers = [];
    selectedActivity2 = null;
    listEl.innerHTML = '<div class="empty-state"><div class="empty-icon">⚖️</div><div class="empty-text">Selecciona primero una actividad en el Paso 1</div></div>';
    hideActivity2Detail();
    return;
  }
  // Filter: same sector AND same ramo, excluding the selected activity itself
  activity2Peers = DATA.filter(d =>
    d.sector === activity1.sector &&
    d.ramo === activity1.ramo &&
    d.codigo !== activity1.codigo
  );
  // If previous selection no longer valid, clear it
  if (selectedActivity2 && !activity2Peers.find(d => d.codigo === selectedActivity2.codigo)) {
    selectedActivity2 = null;
  }
  renderActivity2List(activity2Peers);
}

function renderActivity2List(items) {
  const listEl = document.getElementById('activity2List');
  if (!items.length) {
    listEl.innerHTML = '<div class="empty-state"><div class="empty-icon">🔍</div><div class="empty-text">No hay otras actividades en este ramo</div></div>';
    return;
  }
  listEl.innerHTML = items.map(item => {
    const isSelected = selectedActivity2 && selectedActivity2.codigo === item.codigo;
    return `<div class="activity-item${isSelected ? ' selected' : ''}" onclick="selectActivity2('${escHtml(item.codigo)}')">
      <span class="activity-code">${escHtml(item.codigo)}</span>
      <div>
        <div class="activity-name">${escHtml(item.actividad || item.ramo)}</div>
        <div class="activity-sector">${escHtml(item.ramo)}</div>
      </div>
    </div>`;
  }).join('');
}

function filterActivity2List() {
  const search = document.getElementById('activity2Search').value.toLowerCase().trim();
  if (!search) {
    renderActivity2List(activity2Peers);
    return;
  }
  const filtered = activity2Peers.filter(d => {
    const haystack = (d.actividad + ' ' + d.descripcion + ' ' + d.ramo + ' ' + d.codigo).toLowerCase();
    const kws = (KEYWORDS_MAP[d.codigo] || []).join(' ').toLowerCase();
    return haystack.includes(search) || kws.includes(search);
  });
  renderActivity2List(filtered);
}

function selectActivity2(codigo) {
  selectedActivity2 = DATA.find(d => d.codigo === codigo) || null;
  renderActivity2List(activity2Peers);
  showActivity2Detail();
  updatePaso4();
}

