function getIVAInfo(codigo) {
  if (SECTOR_PRIMARIO_CODIGOS.includes(codigo)) {
    return {
      tasa: 0,
      nota: 'Los municipios no pueden gravar actividades del Sector Primario según la Ley Orgánica del Poder Público Municipal. Por ello no hay información de alícuotas municipales disponible para la mayoría de alcaldías, con excepción del Municipio El Hatillo.',
      excepciones: [],
      esSectorPrimario: true
    };
  }
  return IVA_MAP[codigo] || {tasa: 16, nota: 'Gravado al 16% general (Art. 27 LIVA).', excepciones: []};
}

function calcBaseAfterIVA(ingresosBs, tasaIVA) {
  // Base = ingreso bruto - IVA
  // IVA = ingreso × tasa/100
  // Base = ingreso × (1 - tasa/100)
  if (tasaIVA === 0) return ingresosBs;
  return ingresosBs * (1 - tasaIVA / 100);
}

