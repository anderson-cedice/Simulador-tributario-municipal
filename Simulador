function parseRate(str) {
  // Accept both comma and dot as decimal separator
  return parseFloat(String(str).replace(/\./g, '').replace(',', '.')) || 0;
}

function handleRateInput(el, type) {
  // Format with comma as decimal separator
  let raw = el.value.replace(/[^0-9,]/g, '');
  const parts = raw.split(',');
  if (parts.length > 2) raw = parts[0] + ',' + parts.slice(1).join('');
  const intPart = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  const decPart = parts.length > 1 ? ',' + parts[1] : '';
  el.value = intPart + decPart;
  applyRates();
}

function applyRates() {
  const rawUSD = document.getElementById('inputRateUSD')?.value || '';
  const rawEUR = document.getElementById('inputRateEUR')?.value || '';
  const newUSD = parseRate(rawUSD);
  const newEUR = parseRate(rawEUR);
  if (newUSD > 0) TUSD = newUSD;
  if (newEUR > 0) TEUR = newEUR;
  // Update meta-bar display
  const mUSD = document.getElementById('metaRateUSD');
  const mEUR = document.getElementById('metaRateEUR');
  const mDate = document.getElementById('metaRateDate');
  const rawUSDval = document.getElementById('inputRateUSD')?.value || '';
  const rawEURval = document.getElementById('inputRateEUR')?.value || '';
  if (mUSD) mUSD.textContent = parseRate(rawUSDval) > 0 ? TUSD.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) : '—';
  if (mEUR) mEUR.textContent = parseRate(rawEURval) > 0 ? TEUR.toLocaleString('de-DE', {minimumFractionDigits:2, maximumFractionDigits:2}) : '—';
  if (mDate) {
    const day = document.getElementById('rateDay')?.value || '';
    const monthNames = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    const month = monthNames[parseInt(document.getElementById('rateMonth')?.value || '5')];
    const year = document.getElementById('rateYear')?.value || '2026';
    mDate.textContent = [day, month, year].filter(Boolean).join(' ');
  }
  // Recalculate if already on step 3+
  if (currentStep >= 3) { updateResults(); updatePaso4(); }
}
