  if (minimo2Alert && minimo2Text) {
    if (perfilRequiereMinimo && act2BajaMínimo && inc2Bs > 0) {
      minimo2Alert.style.display = 'flex';
      minimo2Text.innerHTML = `<strong>Mínimo tributable de la segunda actividad en ${escHtml(muniP)}:</strong> ${min2Raw} TCMMV = ${fmtBs(min2Bs)} / ${fmtEur(min2Bs/TEUR)}. El impuesto calculado (${fmtBs(tax2Bs)}) no alcanza el mínimo: se debe cancelar <strong>${fmtBs(min2Bs)}</strong>.`;
    } else {
      minimo2Alert.style.display = 'none';
    }
  }

  // IVA disclaimer for paso 4
  const disc4Box = document.getElementById('ivaDisclaimer4Box');
  const disc4Content = document.getElementById('ivaDisclaimer4Content');
  if (disc4Box && disc4Content && (inc1Bs > 0 || inc2Bs > 0)) {
    disc4Box.style.display = '';
    // Keep collapsed by default
    const disc4ContentEl = document.getElementById('ivaDisclaimer4Content');
    const disc4ChevronEl = document.getElementById('ivaChevron4');
    const disc4BtnEl = disc4ContentEl ? disc4ContentEl.previousElementSibling : null;
    if (disc4ContentEl) disc4ContentEl.style.display = 'none';
    if (disc4ChevronEl) disc4ChevronEl.style.transform = '';
    if (disc4BtnEl) disc4BtnEl.style.borderRadius = '10px';
    const act1Label = selectedActivity ? `${selectedActivity.codigo} — IVA ${ivaInfo1.tasa}%` : '—';
    const act2Label = selectedActivity2 ? `${selectedActivity2.codigo} — IVA ${ivaInfo2.tasa}%` : '—';
    const totalIVABs = iva1Bs + iva2Bs;
    const totalBase = base1AfterIVABs + base2AfterIVABs;
    disc4Content.innerHTML = `
      <div style="font-size:12px; color:#333358; line-height:1.7;">
        <div>📌 <strong>Actividad 1</strong> (${escHtml(act1Label)}): IVA descontado ${fmtCur(iva1Bs, currency)} → base municipal: <strong>${fmtCur(base1AfterIVABs, currency)}</strong></div>
        <div>📌 <strong>Actividad 2</strong> (${escHtml(act2Label)}): IVA descontado ${fmtCur(iva2Bs, currency)} → base municipal: <strong>${fmtCur(base2AfterIVABs, currency)}</strong></div>
        <div style="margin-top:6px; padding-top:6px; border-top:1px solid #DDDDE8;">💡 <strong>Total IVA descontado:</strong> ${fmtCur(totalIVABs, currency)} · <strong>Base combinada:</strong> ${fmtCur(totalBase, currency)}</div>
      </div>
      <div style="font-size:10px; color:#9090B0; margin-top:8px; font-style:italic;">⚠️ Clasificación orientativa. Consulte a un especialista tributario para su caso específico.</div>`;
  } else if (disc4Box) {
    disc4Box.style.display = 'none';
  }

  document.getElementById('paso4Grid').innerHTML = grid;

  // Table: comparison across all munis for both activities
  let thtml = `<thead><tr>
    <th>Municipio</th>
    <th>Alíc. Act. 1</th><th>Impuesto Act. 1</th>
    <th>Alíc. Act. 2</th><th>Impuesto Act. 2</th>
    <th>Total Combinado</th>
  </tr></thead><tbody>`;

  MUNIS.forEach(m => {
    const dd1 = selectedActivity.municipios[m];
    const dd2 = selectedActivity2.municipios[m];
    const a1 = parseFloat(dd1?.alicuota); const a2 = parseFloat(dd2?.alicuota);
    const b1 = calcBaseAfterIVA(toBs(getIncomeRaw(), currency), ivaInfo1.tasa);
    const b2 = calcBaseAfterIVA(toBs(getIncome2Raw(), currency), ivaInfo2.tasa);
    const t1 = (b1 && !isNaN(a1)) ? b1 * a1 / 100 : null;
    const t2 = (b2 && !isNaN(a2)) ? b2 * a2 / 100 : null;
    const tot = (t1 || 0) + (t2 || 0);
    const rowCls = m === muniP ? 'td-highlight' : '';
    thtml += `<tr>
      <td class="td-muni ${rowCls}">${m === muniP ? '⭐ ' : ''}${escHtml(m)}</td>
      <td class="${rowCls}">${isNaN(a1) ? '<span class="td-na">—</span>' : '<span class="td-ali">' + a1 + '%</span>'}</td>
      <td class="${rowCls}">${t1 !== null ? '<span class="td-amount">' + fmtCur(t1, currency) + '</span>' : '<span class="td-na">—</span>'}</td>
      <td class="${rowCls}">${isNaN(a2) ? '<span class="td-na">—</span>' : '<span class="td-ali">' + a2 + '%</span>'}</td>
      <td class="${rowCls}">${t2 !== null ? '<span class="td-amount">' + fmtCur(t2, currency) + '</span>' : '<span class="td-na">—</span>'}</td>
      <td class="${rowCls}" style="font-weight:700;color:var(--naranja);">${(t1 !== null || t2 !== null) ? fmtCur(tot, currency) : '<span class="td-na">—</span>'}</td>
    </tr>`;
  });
  thtml += '</tbody>';
  document.getElementById('paso4Table').innerHTML = thtml;
}

// INIT
function init() {
  // El descargo vive en las dos barras naranjas (pasos 1-2 y pasos 3-5): se copia el mismo contenido
  const p1 = document.getElementById('disclaimerPopover'), p2 = document.getElementById('disclaimerPopover2');
  if (p1 && p2) p2.innerHTML = p1.innerHTML;
  populateRamos();
  renderList(DATA);
}

function populateRamos(sector = '') {
  const ramoSel = document.getElementById('ramoFilter');
  const filtered = sector ? DATA.filter(d => d.sector === sector) : DATA;
  const ramos = [...new Set(filtered.map(d => d.ramo))].sort();
  ramoSel.innerHTML = '<option value="">Todos los ramos</option>' +
    ramos.map(r => `<option value="${escHtml(r)}">${escHtml(r)}</option>`).join('');
}

function applyFilters() {
  const sector = document.getElementById('sectorFilter').value;
  const ramo = document.getElementById('ramoFilter').value;
  const search = document.getElementById('searchInput').value.toLowerCase().trim();

  // Update ramo dropdown when sector changes
  if (sector !== (applyFilters._lastSector || '')) {
    applyFilters._lastSector = sector;
    populateRamos(sector);
  }

  let filtered = DATA.filter(d => {
    if (sector && d.sector !== sector) return false;
    if (ramo && d.ramo !== ramo) return false;
    if (search) {
      const haystack = (d.actividad + ' ' + d.descripcion + ' ' + d.ramo + ' ' + d.codigo).toLowerCase();
      const kws = (KEYWORDS_MAP[d.codigo] || []).join(' ').toLowerCase();
      if (!haystack.includes(search) && !kws.includes(search)) return false;
    }
    return true;
  });

  const count = document.getElementById('activityCount');
  count.textContent = filtered.length === DATA.length
    ? `Mostrando todas las actividades (${DATA.length})`
    : `${filtered.length} actividad${filtered.length !== 1 ? 'es' : ''} encontrada${filtered.length !== 1 ? 's' : ''}`;

  renderList(filtered);
}

function renderList(items) {
  const el = document.getElementById('activityList');
  if (!items.length) {
    el.innerHTML = '<div class="empty-state"><div class="empty-icon">🔍</div><div class="empty-text">No se encontraron actividades</div></div>';
    return;
  }
  let html = '';
  let lastSector = '';
  items.forEach(item => {
    if (item.sector !== lastSector) {
      const sectorLabel = { 'SECTOR PRIMARIO': 'Sector Primario', 'SECTOR SECUNDARIO': 'Sector Secundario', 'SECTOR TERCIARIO': 'Sector Terciario' }[item.sector] || item.sector;
      html += `<div class="section-label">${sectorLabel}</div>`;
      lastSector = item.sector;
    }
    const isSelected = selectedActivity && selectedActivity.codigo === item.codigo;
    html += `<div class="activity-item${isSelected ? ' selected' : ''}" onclick="selectActivity('${escHtml(item.codigo)}')">
      <span class="activity-code">${escHtml(item.codigo)}</span>
      <div>
        <div class="activity-name">${escHtml(item.actividad || item.ramo)}</div>
        <div class="activity-sector">${escHtml(item.ramo)}</div>
      </div>
    </div>`;
  });
  el.innerHTML = html;
}

function selectActivity(codigo) {
  selectedActivity = DATA.find(d => d.codigo === codigo);
  if (!selectedActivity) return;
  renderList(getFilteredData());

  // Show detail
  const detail = document.getElementById('activityDetail');
  const title = document.getElementById('detailTitle');
  const desc = document.getElementById('detailDesc');
  detail.classList.add('visible');

  title.innerHTML = `<span class="activity-code">${escHtml(selectedActivity.codigo)}</span>
    <span class="tag tag-sector">${escHtml(selectedActivity.sector)}</span>
    <span class="tag tag-ramo">${escHtml(selectedActivity.ramo)}</span>
    <span style="font-size:14px;font-weight:600;">${escHtml(selectedActivity.actividad || selectedActivity.ramo)}</span>`;

  const rawDesc = selectedActivity.descripcion || '';
  const cleanDesc = rawDesc.replace(/\\n/g, '\n').replace(/\n/g, '<br>').replace(/•/g, '• ');
  desc.innerHTML = cleanDesc && cleanDesc !== 'Sin descripción necesaria.' && cleanDesc !== 'nan'
    ? cleanDesc
    : '<em>Sin descripción adicional disponible.</em>';

  populateActivity2(selectedActivity);
  updateResults();
  updatePaso4();
  document.getElementById('btnNext1').disabled = false;
}

function getFilteredData() {
  const sector = document.getElementById('sectorFilter').value;
  const ramo = document.getElementById('ramoFilter').value;
  const search = document.getElementById('searchInput').value.toLowerCase().trim();
  return DATA.filter(d => {
    if (sector && d.sector !== sector) return false;
    if (ramo && d.ramo !== ramo) return false;
    if (search) {
      const hay = (d.actividad + ' ' + d.descripcion + ' ' + d.ramo + ' ' + d.codigo).toLowerCase();
      if (!hay.includes(search)) return false;
    }
    return true;
  });
}

function setCurrency(c) {
  currency = c;
  document.getElementById('btnBs').classList.toggle('active', c === 'Bs');
  document.getElementById('btnUsd').classList.toggle('active', c === 'USD');
  document.getElementById('btnEur').classList.toggle('active', c === 'EUR');
  updateProfileUI();
  updateResults();
}

function onProfileChange() {
  updateProfileUI();
  updateResults();
}

// Also update label when period selector changes (already calls updateResults via onPeriodChange)
// but also needs to refresh label text


function updateProfileUI() {
  const profile = document.getElementById('userProfile').value;
  const cfg = PROFILE_CONFIG[profile];
  document.getElementById('incomeLabel').textContent = cfg.inputLabel(currency);
  document.getElementById('incomeInput').placeholder = cfg.placeholder;
}

function updateResults() {
  const muniP = document.getElementById('muniPrimary').value;
  const muniC = document.getElementById('muniCompare').value;
  const profile = document.getElementById('userProfile').value;
  const incomeRaw = getIncomeRaw();
  const incomeInBs = toBs(incomeRaw, currency);

  const noMsg = document.getElementById('noSelectionMsg');
  const resSection = document.getElementById('resultsSection');
  const insightBox = document.getElementById('profileInsightBox');

  if (!selectedActivity || !muniP) {
    noMsg.style.display = '';
    resSection.style.display = 'none';
    insightBox.style.display = 'none';
    const bf3 = document.getElementById('btnFinish3');
    const bn3 = document.getElementById('btnNext3');
    if (bf3) bf3.disabled = true;
    if (bn3) bn3.disabled = true;
    return;
  }

  noMsg.style.display = 'none';
  resSection.style.display = '';

  // IVA calculation
  const ivaInfo = getIVAInfo(selectedActivity.codigo);
  const tasaIVA = ivaInfo.tasa;
  const baseAfterIVABs = calcBaseAfterIVA(incomeInBs, tasaIVA);
  const ivaMontosBs = incomeInBs - baseAfterIVABs;

  // Update IVA disclaimer
  const ivaBox = document.getElementById('ivaDisclaimerBox');
  const ivaContent = document.getElementById('ivaDisclaimerContent');
  if (incomeInBs > 0 && ivaContent) {
    ivaBox.style.display = '';
    // Keep collapsed by default — user opens it with click
    const ivaContentEl = document.getElementById('ivaDisclaimerContent');
    const ivaChevronEl = document.getElementById('ivaChevron');
    const ivaBtnEl = ivaContentEl ? ivaContentEl.previousElementSibling : null;
    if (ivaContentEl) ivaContentEl.style.display = 'none';
    if (ivaChevronEl) ivaChevronEl.style.transform = '';
    if (ivaBtnEl) ivaBtnEl.style.borderRadius = '10px';
    const baseLabel = ivaInfo.esSectorPrimario
      ? `Esta actividad pertenece al <strong>Sector Primario</strong>. Los municipios no pueden gravarla según la Ley Orgánica del Poder Público Municipal, por lo que no aplica descuento de IVA sobre base municipal.`
      : tasaIVA === 0
        ? `La actividad está <strong>exenta de IVA</strong>. El impuesto municipal se calcula sobre el monto completo: <strong>${fmtCur(incomeInBs, currency)}</strong>.`
        : `Se descuenta el <strong>IVA ${tasaIVA}%</strong> (${fmtCur(ivaMontosBs, currency)}) del ingreso bruto. La base para el impuesto municipal es: <strong>${fmtCur(baseAfterIVABs, currency)}</strong>.`;
    const excepcionesHtml = ivaInfo.excepciones.length
      ? `<div style="margin-top:8px; padding-top:8px; border-top:1px solid #DDDDE8;">
           <div style="font-size:11px; font-weight:700; color:#7070A8; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:5px;">⚠️ Subactividades de esta categoría con una tasa diferente</div>
           <ul style="margin:0; padding-left:16px; font-size:12px; color:#5050A0; line-height:1.7;">
             ${ivaInfo.excepciones.map(e => `<li>${escHtml(e)}</li>`).join('')}
           </ul>
         </div>`
      : '';
    ivaContent.innerHTML = `
      <div style="font-size:12px; color:#333358; line-height:1.6;">${baseLabel}</div>
      <div style="font-size:11px; color:#7070A8; margin-top:5px;">${escHtml(ivaInfo.nota)}</div>
      ${excepcionesHtml}
      <div style="font-size:10px; color:#9090B0; margin-top:8px; font-style:italic;">⚠️ Esta clasificación es una aproximación orientativa basada en la Ley del IVA (G.O. N° 6.507 Ext., 29/01/2020). Consulte a un especialista tributario para su caso específico.</div>`;
  } else if (ivaBox) {
    ivaBox.style.display = 'none';
  }

  const pData = selectedActivity.municipios[muniP];
  const cData = muniC ? selectedActivity.municipios[muniC] : null;

  const pAli = parseFloat(pData?.alicuota) || null;
  const cAli = cData ? parseFloat(cData?.alicuota) || null : null;
  const pMin = parseFloat(pData?.minimo) || null;

  // Use IVA-adjusted base for municipal tax calculation
  const pTaxBs = (pAli && baseAfterIVABs) ? (baseAfterIVABs * pAli / 100) : null;
  const cTaxBs = (cAli && baseAfterIVABs) ? (baseAfterIVABs * cAli / 100) : null;

  const pTaxEur = pTaxBs ? pTaxBs / TEUR : null;

  // Mínimo tributable in Bs = minimo * TEUR (minimo is in TCMMV mensual units, approx same base)
  const pMinBs = pMin ? pMin * TEUR : null;

  // Profile insight
  if (pAli !== null && incomeInBs > 0) {
    const cfg = PROFILE_CONFIG[profile];
    const insightHtml = cfg.insight(pAli, pTaxBs, pTaxEur, incomeInBs, muniP, currency);
    document.getElementById('profileInsight').innerHTML = '💡 ' + insightHtml;
    insightBox.style.display = '';
  } else {
    insightBox.style.display = 'none';
  }

  let grid = '';

  // Card 1: Alícuota principal
  if (pAli !== null) {
    grid += `<div class="result-card primary">
      <div class="result-label">Alícuota Municipal</div>
      <div class="result-muni">${escHtml(muniP)}</div>
      <div class="result-value">${pAli}%</div>
      ${pMinBs ? `<div class="result-detail">Mínimo tributable: ${fmtEur(pMinBs/TEUR)} / ${fmtBs(pMinBs)}</div>` : ''}
      <div class="deco"></div>
    </div>`;
  } else {
    grid += `<div class="result-card neutral">
      <div class="result-label">Alícuota Municipal</div>
      <div class="result-muni">${escHtml(muniP)}</div>
      <div class="result-value" style="font-size:16px;color:var(--texto-sub)">No disponible</div>
      <div class="result-detail">Esta actividad no está clasificada en ${escHtml(muniP)}</div>
    </div>`;
  }

  // Card 2: Impuesto calculado principal
  if (pTaxBs !== null) {
    grid += `<div class="result-card secondary">
      <div class="result-label">Impuesto Estimado</div>
      <div class="result-muni">${escHtml(muniP)}</div>
      <div class="result-value">${fmtCur(pTaxBs, currency)}</div>
      <div class="result-detail">${currency === 'USD' ? fmtBs(pTaxBs) + ' · ' + fmtEur(pTaxBs/TEUR) : currency === 'Bs' ? fmtUsd(pTaxBs/TUSD) + ' · ' + fmtEur(pTaxBs/TEUR) : fmtBs(pTaxBs)}</div>
      <div class="deco"></div>
    </div>`;
  } else if (incomeInBs > 0 && pAli === null) {
    grid += `<div class="result-card neutral">
      <div class="result-label">Impuesto Estimado</div>
      <div class="result-muni">${escHtml(muniP)}</div>
      <div class="result-value" style="font-size:16px;color:var(--texto-sub)">—</div>
      <div class="result-detail">Sin datos para calcular</div>
    </div>`;
  } else if (pAli !== null) {
    grid += `<div class="result-card neutral">
      <div class="result-label">Impuesto Estimado</div>
      <div class="result-muni">${escHtml(muniP)}</div>
      <div class="result-value" style="font-size:16px;color:var(--texto-sub)">Ingresa el monto</div>
      <div class="result-detail">Alícuota: ${pAli}%</div>
    </div>`;
  }

  // Cards de comparación
  if (muniC) {
    if (cAli !== null) {
      grid += `<div class="result-card compare">
        <div class="result-label">Alícuota — Comparación</div>
        <div class="result-muni">${escHtml(muniC)}</div>
        <div class="result-value">${cAli}%</div>
        ${pAli !== null ? `<div class="result-detail">${cAli > pAli ? '▲ Mayor' : cAli < pAli ? '▼ Menor' : '= Igual'} que ${escHtml(muniP)} (${Math.abs(cAli - pAli).toFixed(2)} pp)</div>` : ''}
        <div class="deco"></div>
      </div>`;
    } else {
      grid += `<div class="result-card neutral">
        <div class="result-label">Alícuota — Comparación</div>
        <div class="result-muni">${escHtml(muniC)}</div>
        <div class="result-value" style="font-size:16px;color:var(--texto-sub)">No disponible</div>
      </div>`;
    }

    if (cTaxBs !== null) {
      const diff = pTaxBs !== null ? cTaxBs - pTaxBs : null;
      grid += `<div class="result-card compare">
        <div class="result-label">Impuesto — Comparación</div>
        <div class="result-muni">${escHtml(muniC)}</div>
        <div class="result-value">${fmtCur(cTaxBs, currency)}</div>
        ${diff !== null ? `<div class="result-detail">${diff > 0 ? '▲ Pagas ' + fmtCur(Math.abs(diff), currency) + ' más que en ' + escHtml(muniP) : diff < 0 ? '▼ Ahorras ' + fmtCur(Math.abs(diff), currency) + ' vs ' + escHtml(muniP) : '= Mismo monto que ' + escHtml(muniP)}</div>` : ''}
        <div class="deco"></div>
      </div>`;
    } else if (incomeInBs > 0) {
      grid += `<div class="result-card neutral">
        <div class="result-label">Impuesto — Comparación</div>
        <div class="result-muni">${escHtml(muniC)}</div>
        <div class="result-value" style="font-size:16px;color:var(--texto-sub)">—</div>
        <div class="result-detail">Sin datos disponibles</div>
      </div>`;
    }
  }

  document.getElementById('resultsGrid').innerHTML = grid;

  // Mínimo tributable alert — solo para empresario/inversionista y solo cuando tax < mínimo
  const minimoAlert = document.getElementById('minimoAlert');
  const perfil = document.getElementById('userProfile').value;
  const perfilRequiereMinimo = (perfil === 'empresario' || perfil === 'inversionista');
  const taxBajaMínimo = pMinBs && pTaxBs !== null && pTaxBs < pMinBs;
  if (perfilRequiereMinimo && taxBajaMínimo && incomeInBs > 0) {
    minimoAlert.style.display = 'flex';
    document.getElementById('minimoText').innerHTML =
      `<strong>Mínimo tributable en ${escHtml(muniP)}:</strong> ${pMin} TCMMV = ${fmtEur(pMinBs/TEUR)} / ${fmtBs(pMinBs)}. ` +
      `Tu impuesto calculado (${fmtBs(pTaxBs)}${currency === 'USD' ? ' / ' + fmtUsd(pTaxBs/TUSD) : currency === 'EUR' ? ' / ' + fmtEur(pTaxBs/TEUR) : ''}) no alcanza el mínimo: deberías pagar <strong>${fmtBs(pMinBs)}</strong>.`;
  } else {
    minimoAlert.style.display = 'none';
  }

  updatePaso4();

  // Wizard nav: enable Finalizar / Comparar buttons once there's a valid amount entered
  const bf3 = document.getElementById('btnFinish3');
  const bn3 = document.getElementById('btnNext3');
  const hasAmount = incomeInBs > 0;
  if (bf3) bf3.disabled = !hasAmount || !selectedActivity || !muniP;
  if (bn3) bn3.disabled = !hasAmount || !selectedActivity || !muniP;
}

// UTILS
function fmtBs(v) {
  return 'Bs. ' + v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtEur(v) {
  return '€ ' + v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function fmtUsd(v) {
  return '$ ' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ========== WIZARD / PAGINATED NAVIGATION ==========

function goToStep(step, direction) {
  const dir = direction || (step > currentStep ? 'forward' : 'back');
  document.querySelectorAll('.step-wrapper').forEach(el => {
    const s = parseInt(el.dataset.step, 10);
    el.classList.remove('active', 'back-anim');
    if (s === step) {
      el.classList.add('active');
      if (dir === 'back') el.classList.add('back-anim');
    }
  });
  currentStep = step;
  closeDisclaimers();
  updateProgressBar(step);
  if (step === 5) {
    try {
      generateStep5();
    } catch(e) {
      const c = document.getElementById('step5Content');
      if (c) c.innerHTML = `<div class="empty-state"><div class="empty-icon">⚠️</div><div class="empty-text">Error al generar el análisis: ${e.message}. Por favor regresa al Paso 3 e intenta de nuevo.</div></div>`;
    }
  }
  // Show/hide progress bar and meta-bar on home screen
  const progressWrapper = document.getElementById('progressWrapper');
  if (progressWrapper) progressWrapper.style.display = step === 0 ? 'none' : '';
  // Update back button in step 5 to go to correct prior step
  const backBtn5 = document.getElementById('btnBackStep5');
  if (backBtn5) {
    const cameFrom4 = selectedActivity2 !== null;
    backBtn5.onclick = () => goToStep(cameFrom4 ? 4 : 3);
    backBtn5.textContent = '← Atrás';
  }
  // Show/hide meta-bar based on step
  const metaBasic = document.getElementById('metaBarBasic');
  const metaRates = document.getElementById('metaBarRates');
  if (step <= 2) {
    if (metaBasic) metaBasic.style.display = step === 0 ? 'none' : '';
    if (metaRates) metaRates.style.display = 'none';
  } else {
    if (metaBasic) metaBasic.style.display = 'none';
    if (metaRates) metaRates.style.display = '';
    applyRates(); // ensure rates and date are up to date when entering step 3+
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function updateProgressBar(step) {
  document.querySelectorAll('.progress-step').forEach(el => {
    const s = parseInt(el.dataset.pstep, 10);
    el.classList.remove('active', 'done');
    if (s < step) el.classList.add('done');
    else if (s === step) el.classList.add('active');
  });
  document.querySelectorAll('.progress-line').forEach(el => {
    const s = parseInt(el.dataset.pline, 10);
    el.classList.toggle('done', s < step);
  });
}

function validateStep2() {
  const muniP = document.getElementById('muniPrimary').value;
  document.getElementById('btnNext2').disabled = !muniP;
}

function closeDisclaimers() {
  document.querySelectorAll('.disclaimer-popover.open').forEach(p => p.classList.remove('open'));
}
function toggleDisclaimer(e) {
  e.stopPropagation();
  const pop = e.currentTarget.parentElement.querySelector('.disclaimer-popover');
  const wasOpen = pop && pop.classList.contains('open');
  closeDisclaimers();
  if (pop && !wasOpen) pop.classList.add('open');
}
// Cerrar el recuadro al hacer clic fuera de él
document.addEventListener('click', function(e) {
  if (!e.target.closest('.disclaimer-popover') && !e.target.closest('.disclaimer-trigger')) closeDisclaimers();
});

function toggleIVADisclaimer(contentId, chevronId) {
  const el = document.getElementById(contentId);
  const ch = document.getElementById(chevronId);
  const btn = el.previousElementSibling;
  if (!el) return;
  const isOpen = el.style.display !== 'none';
  el.style.display = isOpen ? 'none' : 'block';
  if (ch) ch.style.transform = isOpen ? '' : 'rotate(180deg)';
  if (btn) {
    btn.style.borderRadius = isOpen ? '10px' : '10px 10px 0 0';
  }
}



function sortedForActivity(actObj, baseAmtBs) {
  return MUNIS.map(m => {
    const d = actObj.municipios[m];
    const ali = parseFloat(d?.alicuota);
    const miniRaw = parseFloat(d?.minimo) || 0;
    const miniBs = miniRaw * TEUR;
    const taxBs = (!isNaN(ali) && baseAmtBs > 0) ? baseAmtBs * ali / 100 : null;
    const efectivoBs = (taxBs !== null && miniBs > 0 && taxBs < miniBs) ? miniBs : taxBs;
    const bajaMínimo = taxBs !== null && miniBs > 0 && taxBs < miniBs;
    return { muni: m, ali: isNaN(ali) ? null : ali, taxBs, miniBs, miniRaw, efectivoBs, bajaMínimo };
  }).filter(d => d.taxBs !== null).sort((a, b) => a.taxBs - b.taxBs);
}

function narrativeBlock(actNameStr, sortedData, baseAmtBs, bgColor, borderColor, titleColor, profileLabel, profileIcon, profileMode, isCombined, muniP) {
  if (!sortedData.length) return '';
  const cheap = sortedData[0];
  const exp = sortedData[sortedData.length - 1];
  const selFound = sortedData.find(d => d.muni === muniP);
  const selMissing = !selFound;
  const sel = selFound || null;
  const isSingleMuni = sortedData.length === 1;
  const allSame = sortedData.every(d => d.taxBs === cheap.taxBs);
  const isConsumerMode = profileMode === 'consumidor';
  const isInvestor = profileMode === 'inversionista';
  const actTitle = escHtml(String(actNameStr).replace(/[.\s]+$/, ''));
  const baseLine = `<div style="font-size:11px;color:var(--texto-sub);margin:-4px 0 12px;">Base tras IVA: <strong>${fmtCur(baseAmtBs, currency)}</strong></div>`;

  const munisBajoMinimo = sortedData.filter(d => d.bajaMínimo);
  const selBajaMínimo = sel ? sel.bajaMínimo : false;

  const minimoWarning = munisBajoMinimo.length > 0 ? `
    <div style="background:var(--naranja-palido);border:1px solid var(--naranja-borde);border-radius:8px;padding:12px 14px;margin-top:10px;">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--naranja);margin-bottom:6px;">&#9888;&#65039; Mínimo Tributable aplicable</div>
      ${munisBajoMinimo.map(d => `<p style="font-size:12px;color:var(--texto);line-height:1.7;margin:0 0 4px;">
        En <strong>${escHtml(d.muni)}</strong>, el impuesto calculado (${fmtCur(d.taxBs, currency)}) no supera el mínimo tributable de <strong>${fmtCur(d.miniBs, currency)}</strong> (${d.miniRaw} TCMMV / ${fmtEur(d.miniBs/TEUR)}). Se cobrará el <strong>mínimo tributable</strong>.
      </p>`).join('')}
      ${selBajaMínimo ? `<p style="font-size:12px;color:var(--naranja);line-height:1.7;margin:4px 0 0;font-weight:600;">
        Para ${escHtml(sel.muni)}, la comparación de alícuotas queda sin relevancia práctica: el cobro efectivo será el mínimo tributable.
      </p>` : ''}
    </div>` : '';

  const missingNote = selMissing ? `<p style="font-size:12px;color:var(--naranja);background:var(--naranja-palido);border:1px solid var(--naranja-borde);border-radius:8px;padding:10px 12px;line-height:1.7;margin:0 0 12px;">&#8505;&#65039; Esta actividad no está registrada en <strong>${escHtml(muniP)}</strong>, el municipio que seleccionaste. Aun así, se presenta la comparación con los municipios donde sí está clasificada.</p>` : '';

  const titlePrefix = isConsumerMode ? '&#128100;' : isInvestor ? '&#128200;' : '&#127970;';
  const titleSuffix = isConsumerMode ? 'Análisis de costo para el consumidor'
    : isInvestor ? 'Análisis de impacto en retorno de inversión'
    : 'Análisis de competitividad tributaria';

  function getSelParagraph() {
    if (!sel) return '';
    if (sel.muni === cheap.muni) {
      return isConsumerMode
        ? `&#129001; Tu municipio seleccionado, <strong>${escHtml(sel.muni)}</strong>, es el que menor carga tributaria aplica, favoreciendo precios más accesibles.`
        : isInvestor
        ? `&#9989; Tu municipio seleccionado, <strong>${escHtml(sel.muni)}</strong>, es el más favorable para tu retorno proyectado.`
        : `&#9989; Tu municipio seleccionado, <strong>${escHtml(sel.muni)}</strong>, ya es el más competitivo fiscalmente.`;
    }
    if (sel.taxBs === cheap.taxBs && sel.muni !== cheap.muni) {
      return isConsumerMode
        ? `&#129001; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, tiene la misma alícuota del ${sel.ali}% que el menos gravoso (${fmtCur(sel.taxBs, currency)}), igualmente favorable para el consumidor.`
        : `&#9989; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, tiene la misma alícuota del ${sel.ali}% que el más competitivo (${fmtCur(sel.taxBs, currency)}), igualmente favorable.`;
    }
    if (sel.taxBs === exp.taxBs && sel.muni !== exp.muni) {
      return isConsumerMode
        ? `&#128308; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, comparte la alícuota más alta del ${sel.ali}% (${fmtCur(sel.taxBs, currency)}), lo que puede encarecer el precio final.`
        : `&#9888;&#65039; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, comparte la alícuota más alta del ${sel.ali}% (${fmtCur(sel.taxBs, currency)}), la menos favorable.`;
    }
    if (sel.muni === exp.muni) {
      return isConsumerMode
        ? `&#128308; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, aplica la alícuota más alta (${sel.ali}%, ${fmtCur(sel.taxBs, currency)}), tendiendo a encarecer más los precios.`
        : `&#9888;&#65039; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, aplica la mayor presión fiscal (${sel.ali}%, ${fmtCur(sel.taxBs, currency)}).`;
    }
    return isConsumerMode
      ? `&#128205; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, ocupa una posición intermedia con alícuota del ${sel.ali}% (${fmtCur(sel.taxBs, currency)}).`
      : isInvestor
      ? `&#128205; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, tiene alícuota del ${sel.ali}% (${fmtCur(sel.taxBs, currency)}), ${fmtCur(sel.taxBs - cheap.taxBs, currency)} más que el más favorable.`
      : `&#128205; Tu municipio, <strong>${escHtml(sel.muni)}</strong>, tiene alícuota del ${sel.ali}% (${fmtCur(sel.taxBs, currency)}), diferencia de ${fmtCur(sel.taxBs - cheap.taxBs, currency)} vs. el más competitivo.`;
  }

  const closingText = isConsumerMode
    ? 'Desde una perspectiva de libertad económica, los impuestos municipales se trasladan al precio de los bienes y servicios. Conocer la carga de cada municipio te permite tomar decisiones más informadas sobre dónde consumes.'
    : isInvestor
    ? 'Desde una perspectiva de libre mercado, la carga tributaria municipal es un factor determinante en la rentabilidad neta. Comparar alícuotas entre municipios permite identificar dónde tu capital puede rendir más.'
    : 'Desde una perspectiva de libre mercado, la competitividad tributaria entre municipios incentiva a las alcaldías a ofrecer mejores condiciones. Conocer estas diferencias te da poder de planificación.';

  if (isSingleMuni) {
    const txt = isConsumerMode
      ? `Esta actividad solo tiene clasificador en <strong>${escHtml(cheap.muni)}</strong> (${cheap.ali}%, impuesto: <strong>${fmtCur(cheap.taxBs, currency)}</strong>). Esta carga puede trasladarse al precio final que pagas.`
      : isInvestor
      ? `Esta actividad solo tiene clasificador en <strong>${escHtml(cheap.muni)}</strong> (${cheap.ali}%, impuesto: <strong>${fmtCur(cheap.taxBs, currency)}</strong>). Este monto reduce directamente tu retorno proyectado.`
      : `Esta actividad solo tiene clasificador en <strong>${escHtml(cheap.muni)}</strong> (${cheap.ali}%, impuesto: <strong>${fmtCur(cheap.taxBs, currency)}</strong>). Sin otros municipios, no es posible comparar competitividad.`;
    return `<div style="background:${bgColor};border:1.5px solid ${borderColor};border-radius:12px;padding:18px 20px;margin-bottom:16px;">
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:${titleColor};margin-bottom:10px;">${titlePrefix} ${titleSuffix} — ${actTitle}</div>
      ${baseLine}
      ${missingNote}
      <p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0 0 10px;">${txt}</p>
      ${minimoWarning}
      <p style="font-size:12px;color:var(--texto-sub);margin-top:12px;font-style:italic;">${closingText}</p>
    </div>`;
  }

  if (allSame) {
    const txt = isConsumerMode
      ? `Todos los municipios disponibles aplican la misma alícuota del <strong>${cheap.ali}%</strong> (${fmtCur(cheap.taxBs, currency)}). La carga trasladada al precio final es idéntica en cualquier municipio.`
      : isInvestor
      ? `Todos los municipios aplican la misma alícuota del <strong>${cheap.ali}%</strong> (${fmtCur(cheap.taxBs, currency)}). El impacto sobre tu retorno es idéntico en cualquiera de ellos.`
      : `Todos los municipios aplican la misma alícuota del <strong>${cheap.ali}%</strong> (${fmtCur(cheap.taxBs, currency)}). No hay ventaja fiscal diferencial entre ellos.`;
    return `<div style="background:${bgColor};border:1.5px solid ${borderColor};border-radius:12px;padding:18px 20px;margin-bottom:16px;">
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:${titleColor};margin-bottom:10px;">${titlePrefix} ${titleSuffix} — ${actTitle}</div>
      ${baseLine}
      ${missingNote}
      <p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0 0 10px;">${txt}</p>
      ${minimoWarning}
      <p style="font-size:12px;color:var(--texto-sub);margin-top:12px;font-style:italic;">${closingText}</p>
    </div>`;
  }

  const cheapTxt = isConsumerMode
    ? `&#129001; <strong>${escHtml(cheap.muni)}</strong> aplica la alícuota más baja (${cheap.ali}%), con impuesto de <strong>${fmtCur(cheap.taxBs, currency)}</strong>. Menor carga tributaria favorece precios más accesibles.`
    : isInvestor
    ? `&#127942; <strong>${escHtml(cheap.muni)}</strong> es el municipio que mejor preserva tu retorno (${cheap.ali}%, <strong>${fmtCur(cheap.taxBs, currency)}</strong>).`
    : `&#127942; <strong>${escHtml(cheap.muni)}</strong> es el más competitivo fiscalmente (${cheap.ali}%, <strong>${fmtCur(cheap.taxBs, currency)}</strong>).`;

  const expTxt = isConsumerMode
    ? `&#128308; <strong>${escHtml(exp.muni)}</strong> aplica la alícuota más alta (${exp.ali}%, <strong>${fmtCur(exp.taxBs, currency)}</strong>), tendiendo a encarecer más el precio final.`
    : isInvestor
    ? `&#9888;&#65039; <strong>${escHtml(exp.muni)}</strong> tiene mayor impacto sobre tu retorno (${exp.ali}%, <strong>${fmtCur(exp.taxBs, currency)}</strong>).`
    : `&#9888;&#65039; <strong>${escHtml(exp.muni)}</strong> aplica la mayor presión fiscal (${exp.ali}%, <strong>${fmtCur(exp.taxBs, currency)}</strong>).`;

  const selPara = getSelParagraph();

  return `<div style="background:${bgColor};border:1.5px solid ${borderColor};border-radius:12px;padding:18px 20px;margin-bottom:16px;">
    <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:${titleColor};margin-bottom:10px;">${titlePrefix} ${titleSuffix} — ${actTitle}</div>
      ${baseLine}
    ${missingNote}
    <p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0 0 10px;">${cheapTxt}</p>
    <p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0 0 10px;">${expTxt}</p>
    ${selPara ? `<p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0 0 10px;">${selPara}</p>` : ''}
    ${minimoWarning}
    <p style="font-size:12px;color:var(--texto-sub);margin-top:12px;font-style:italic;">${closingText}</p>
  </div>`;
}

function generateStep5() {
  const container = document.getElementById('step5Content');
  if (!container) return;

  const profile = document.getElementById('userProfile')?.value || 'consumidor';
  const muniP = document.getElementById('muniPrimary')?.value || '';
  const act1 = selectedActivity;
  const act2 = selectedActivity2;
  const incRaw = getIncomeRaw();
  const inc2Raw = getIncome2Raw();
  const incBs = toBs(incRaw, currency);
  const inc2Bs = act2 ? toBs(inc2Raw, currency) : 0;
  const ivaInfo1 = act1 ? getIVAInfo(act1.codigo) : {tasa:16};
  const ivaInfo2 = act2 ? getIVAInfo(act2.codigo) : {tasa:16};
  const base1 = calcBaseAfterIVA(incBs, ivaInfo1.tasa);
  const base2 = act2 ? calcBaseAfterIVA(inc2Bs, ivaInfo2.tasa) : 0;
  const isConsumer = profile === 'consumidor';

  if (!act1) { container.innerHTML = '<div class="empty-state"><div class="empty-icon">&#9888;&#65039;</div><div class="empty-text">Selecciona una actividad en el Paso 1.</div></div>'; return; }
  if (!muniP) { container.innerHTML = '<div class="empty-state"><div class="empty-icon">&#9888;&#65039;</div><div class="empty-text">Selecciona un municipio en el Paso 2.</div></div>'; return; }
  if (!incRaw || isNaN(incRaw) || incRaw <= 0) { container.innerHTML = '<div class="empty-state"><div class="empty-icon">&#9888;&#65039;</div><div class="empty-text">Ingresa un monto válido en el Paso 3.</div></div>'; return; }

  const sorted1 = sortedForActivity(act1, base1);
  if (!sorted1.length) { container.innerHTML = '<div class="empty-state"><div class="empty-icon">&#128237;</div><div class="empty-text">No hay datos de alícuotas disponibles para esta actividad.</div></div>'; return; }

  const profLabel = profile === 'inversionista' ? 'inversionista' : profile === 'empresario' ? 'empresario / comerciante' : '';
  const profIcon = profile === 'inversionista' ? '&#128200;' : '&#127970;';

  const bgC = isConsumer ? 'var(--naranja-palido)' : profile === 'inversionista' ? '#EEF0FF' : 'var(--verde-claro)';
  const bdC = isConsumer ? 'var(--naranja-borde)' : profile === 'inversionista' ? 'rgba(91,82,216,0.25)' : 'rgba(46,125,79,0.25)';
  const tC  = isConsumer ? 'var(--naranja)' : profile === 'inversionista' ? '#5B52D8' : 'var(--verde-oscuro)';

  const actNameShort = act1.actividad || act1.ramo;
  const act2NameShort = act2 ? (act2.actividad || act2.ramo) : '';

  let narrative = narrativeBlock(actNameShort, sorted1, base1, bgC, bdC, tC, profLabel, profIcon, profile, false, muniP);
  if (act2) {
    const sorted2 = sortedForActivity(act2, base2);
    if (sorted2.length) {
      narrative += narrativeBlock(act2NameShort, sorted2, base2, bgC, bdC, tC, profLabel, profIcon, profile, true, muniP);
    } else {
      const motivo = (!inc2Raw || isNaN(inc2Raw) || inc2Raw <= 0)
        ? 'No ingresaste un monto para esta segunda actividad, por lo que no se puede calcular su análisis. Vuelve al Paso 4 y escribe el monto para incluirla.'
        : 'Esta actividad no tiene alícuotas registradas en ninguno de los municipios, por lo que no hay base para analizarla.';
      narrative += `<div style="background:var(--gris-claro);border:1.5px solid var(--gris-borde);border-radius:12px;padding:16px 20px;margin-bottom:16px;">
        <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--texto-sub);margin-bottom:8px;">&#8505;&#65039; Segunda actividad sin análisis — ${escHtml(String(act2NameShort).replace(/[.\s]+$/, ''))}</div>
        <p style="font-size:13px;color:var(--texto);line-height:1.8;margin:0;">${motivo}</p>
      </div>`;
    }
  }

  const rankAllEqual = sorted1.every(d => d.taxBs === sorted1[0].taxBs);
  const rankColors = ['#2E7D4F','#5B9A72','#9EB8A9','#D08050','#C0392B'];
  const rankEmojis = ['&#129351;','&#129352;','&#129353;','4&#65039;&#8419;','5&#65039;&#8419;'];
  const muniCmp = document.getElementById('muniCompare')?.value || '';
  const showPos = !rankAllEqual;
  const noDataMunis = MUNIS.filter(m => !sorted1.some(d => d.muni === m));
  const rowCls = m => m === muniP ? 'td-highlight' : (m === muniCmp ? 'td-compare-highlight' : '');
  const mark = m => m === muniP ? '&#11088; ' : (m === muniCmp ? '&#128309; ' : '');
  const amtColor = i => rankAllEqual ? 'var(--texto)' : rankColors[i];
  let rowsHtml = sorted1.map((d, i) => {
    const rc = rowCls(d.muni);
    const amt = v => `<td class="${rc}"><span class="td-amount" style="color:${amtColor(i)};">${v}</span></td>`;
    return `<tr>
      ${showPos ? `<td class="${rc}" style="text-align:center;font-size:18px;">${rankEmojis[i]}</td>` : ''}
      <td class="td-muni ${rc}">${mark(d.muni)}${escHtml(d.muni)}</td>
      <td class="${rc}"><span class="td-ali">${d.ali}%</span></td>
      <td class="${rc}">${d.miniRaw > 0 ? `<span class="minimo-badge">${d.miniRaw} TCMMV</span> <span style="font-size:11px;color:var(--texto-sub)">(${fmtBs(d.miniBs)})</span>` : '<span class="td-na">—</span>'}</td>
      ${amt(fmtBs(d.taxBs))}${amt(fmtUsd(d.taxBs / TUSD))}${amt(fmtEur(d.taxBs / TEUR))}
    </tr>`;
  }).join('');
  rowsHtml += noDataMunis.map(m => {
    const rc = rowCls(m);
    return `<tr style="opacity:0.65;">
      ${showPos ? `<td class="${rc}" style="text-align:center;">—</td>` : ''}
      <td class="td-muni ${rc}">${mark(m)}${escHtml(m)}</td>
      <td class="${rc}" colspan="5"><span class="td-na">Actividad no registrada en este municipio</span></td>
    </tr>`;
  }).join('');
  let rankHtml = `<div class="compare-table-wrap"><table>
    <thead><tr>${showPos ? '<th>Puesto</th>' : ''}<th>Municipio</th><th>Alícuota</th><th>Mínimo Tributable (€)</th><th>Impuesto (Bs.)</th><th>Impuesto (USD)</th><th>Impuesto (€)</th></tr></thead>
    <tbody>${rowsHtml}</tbody>
  </table></div>
  <div style="font-size:11px;color:var(--texto-sub);margin-top:8px;">&#11088; Tu municipio${muniCmp ? ' · &#128309; Municipio de comparación' : ''}</div>`;

  const rankSingle = sorted1.length === 1;
  const rankTitle = rankAllEqual
    ? (rankSingle
        ? (isConsumer ? '&#128184; Carga tributaria por municipio' : '&#128202; Comparación fiscal por municipio')
        : (isConsumer ? '&#128184; Carga tributaria por municipio (igual en todos)' : '&#128202; Comparación fiscal por municipio (sin diferencias)'))
    : (isConsumer ? '&#128184; Carga tributaria por municipio (de menor a mayor)' : '&#127942; Ranking de competitividad fiscal (mejor a peor)');
  if (rankAllEqual) {
    rankHtml = (rankSingle
      ? `<p style="font-size:12px;color:var(--texto-sub);line-height:1.7;margin:0 0 10px;">Solo <strong>${escHtml(sorted1[0].muni)}</strong> tiene datos para esta actividad, por lo que no hay un orden de mejor a peor para comparar.</p>`
      : `<p style="font-size:12px;color:var(--texto-sub);line-height:1.7;margin:0 0 10px;">Los municipios con datos para esta actividad aplican la misma alícuota (${sorted1[0].ali}%), por lo que no hay un orden de mejor a peor: la carga es igual en todos.</p>`) + rankHtml;
  }

  container.innerHTML = `
    ${narrative}
    <div style="margin-bottom:8px;">
      <div style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--texto-sub);margin-bottom:10px;">${rankTitle}</div>
      ${act2 ? '<div style="font-size:11px;color:var(--texto-sub);margin:-4px 0 10px;">Corresponde a la primera actividad analizada.</div>' : ''}
      ${rankHtml}
    </div>
    <div style="font-size:10px;color:var(--texto-sub);font-style:italic;margin-top:8px;">
      &#9888;&#65039; Este análisis es orientativo. Consulte a un especialista tributario para decisiones formales.
    </div>`;
}

init();
updateProfileUI();
goToStep(0);
</script>
