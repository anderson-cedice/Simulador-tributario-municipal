    <div class="deco"></div>
  </div>`;

  // Card: total combinado
  const pctCombinado = totalIncBs > 0 ? ((totalTaxBs / totalIncBs) * 100).toFixed(2) : null;
  grid += `<div class="result-card secondary">
    <div class="result-label">Impuesto Total Combinado</div>
    <div class="result-muni">${escHtml(muniP)}</div>
    <div class="result-value">${fmtCur(totalTaxBs, currency)}</div>
    <div class="result-detail">${pctCombinado ? pctCombinado + '% de tus ingresos combinados (' + fmtCur(totalIncBs, currency) + ')' : ''}</div>
