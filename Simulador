  const ali2 = parseFloat(d2?.alicuota) || null;
  const tax1Bs = (ali1 && base1AfterIVABs) ? base1AfterIVABs * ali1 / 100 : null;
  const tax2Bs = (ali2 && base2AfterIVABs) ? base2AfterIVABs * ali2 / 100 : null;
  const totalTaxBs = (tax1Bs || 0) + (tax2Bs || 0);

  let grid = '';

  // Card: impuesto actividad 1
  grid += `<div class="result-card primary">
